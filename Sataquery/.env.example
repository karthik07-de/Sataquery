# ═══════════════════════════════════════════════════════════════════
# SatQuery AI — Frontend Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ═══════════════════════════════════════════════════════════════════

# ─── Backend API URL ────────────────────────────────────────────────
# Leave empty in development — the Vite proxy (/api → :8000) handles it.
# Set to your deployed backend URL in production.
#   Development : (leave empty — proxy is used automatically)
#   Production  : https://your-backend.onrender.com
VITE_API_BASE_URL=

# ─── Gemini AI (required for AI chat features) ───────────────────────
# Powers the in-app AI chat panel and NL query features.
# Get a FREE key at: https://aistudio.google.com/apikey
# No billing required for free tier.
VITE_GEMINI_API_KEY=

# ─── Groq AI (optional fallback) ────────────────────────────────────
# Optional fallback AI provider (text + vision).
# Get a free key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=

# ─── App ────────────────────────────────────────────────────────────
VITE_APP_ENV=production

# ═══════════════════════════════════════════════════════════════════
# NOTE: No Google Maps API key is required.
# The map uses OpenStreetMap tiles which are free with no key needed.
# ═══════════════════════════════════════════════════════════════════
