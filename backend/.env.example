# SatQuery AI — PostgreSQL / PostGIS / pgvector environment
#
# Copy this file to .env and fill in the real values.
# The backend defaults to SQLite (./satquery.db) when DATABASE_URL is left
# as the dev default, so Postgres is optional for local development.

APP_NAME=SatQuery AI backend
APP_VERSION=0.1.0
ENVIRONMENT=development

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production

# Optional comma-separated API keys. When set, requests must send
# `X-API-Key: <key>`. Leave empty for open development access.
API_KEYS=

# ------------------------------------------------------------------
# PostgreSQL / PostGIS / pgvector (production recommended)
# ------------------------------------------------------------------
# Local dev default is SQLite (zero-config). For PostGIS:
#   postgresql+psycopg2://user:pass@localhost:5432/satquery
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/satquery

# PostgreSQL role that Alembic migrations connect as (can differ from app role).
DATABASE_MIGRATIONS_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/satquery

# pgvector embedding dimension used by imagery_embeddings.embedding.
# Must match the model you use to generate embeddings (e.g. 384, 512, 768, 1536).
EMBEDDING_DIMENSION=384

# ------------------------------------------------------------------
# Security (JWT-ready, but JWT is not enforced yet)
# ------------------------------------------------------------------
# JWT algorithm + expiry (used once JWT auth is wired in).
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------
# Uploads / outputs
# ------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=200
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
REPORTS_DIR=./reports
MODEL_DIR=./models
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.tif,.tiff

# ------------------------------------------------------------------
# Satellite data sources
# ------------------------------------------------------------------
# Copernicus Data Space Ecosystem (future imagery acquisition)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_AUTH_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_STAC_URL=https://catalog.dataspace.copernicus.eu/stac

# Google Maps / Mapbox / OpenFreeMap (frontend tiles / geocoding)
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------
# LLM (optional, for explaining real results only)
# ------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------
# ML models
# ------------------------------------------------------------------
# Building detection uses a YOLO model. Point BUILDING_MODEL_PATH at
# downloaded weights (e.g. models/yolov8n.pt) and set USE_BUILDING_MODEL=true.
USE_BUILDING_MODEL=false
BUILDING_MODEL_PATH=
BUILDING_MODEL_CONFIDENCE=0.35

# ------------------------------------------------------------------
# Object storage (future)
# ------------------------------------------------------------------
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
